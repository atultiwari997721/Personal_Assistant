# ===================================================
# Multi-Agent AI SaaS Platform - Environment Configuration
# ===================================================

# --- Server Ports ---
PORT_GATEWAY=8000
PORT_AUTH=8001
PORT_PAYMENT=8002
PORT_AGENT=8003
PORT_CLIENT=3000

# --- Databases & Cache ---
MONGO_URI=mongodb://localhost:27017/cortex_ai
# In Docker: mongodb://mongo:27017/cortex_ai

REDIS_URL=redis://localhost:6379
# In Docker: redis://redis:6379

# --- Authentication & JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=

# --- Google Sign-In (OAuth 2.0 Web Client ID; same ID for website and server) ---
GOOGLE_CLIENT_ID=
# Optional local developer override. start-dev enables its demo login only on localhost.
ALLOW_DEMO_AUTH=
VITE_GOOGLE_CLIENT_ID=

# --- AI Models & Tool APIs ---
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
XAI_API_KEY=
XAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_API_KEY=
GROQ_MODEL=
HF_TOKEN=
HF_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
# Used only by Docker Compose to reach Ollama running on the host machine.
OLLAMA_DOCKER_URL=http://host.docker.internal:11434/v1

# Tavily Web Search API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# --- Razorpay Payments ---
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret

# --- Microservices Internal URLs (Used by API Gateway) ---
AUTH_SERVICE_URL=http://127.0.0.1:8001
PAYMENT_SERVICE_URL=http://127.0.0.1:8002
AGENT_SERVICE_URL=http://127.0.0.1:8003
